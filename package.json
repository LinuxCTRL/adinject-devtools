{
  "name": "adinject-devtools",
  "version": "1.0.0",
  "description": "Visual Ad Inspector, Placement Advisor, Policy Auditor & Mock Simulator for adinject-react",
  "author": "LinuxCTRL",
  "license": "MIT",
  "keywords": [
    "adinject",
    "adinject-react",
    "devtools",
    "ad-inspector",
    "placement-advisor",
    "zero-cls",
    "adsense-debug",
    "react",
    "nextjs"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinuxCTRL/adinject-devtools.git"
  },
  "homepage": "https://github.com/LinuxCTRL/adinject-devtools#readme",
  "bugs": {
    "url": "https://github.com/LinuxCTRL/adinject-devtools/issues"
  },
  "scripts": {
    "build": "tsup && node -e 'const fs = require(\"fs\"); [\"dist/index.js\", \"dist/index.mjs\"].forEach(f => { if (fs.existsSync(f)) { const c = fs.readFileSync(f, \"utf8\"); if (!c.startsWith(\"\\\"use client\\\"\")) fs.writeFileSync(f, \"\\\"use client\\\";\\n\" + c); } });'",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "adinject-react": ">=1.0.0",
    "react": ">=18.0.0 || >=19.0.0",
    "react-dom": ">=18.0.0 || >=19.0.0"
  },
  "peerDependenciesMeta": {
    "adinject-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
